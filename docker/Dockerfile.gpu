# Stage 1: Build Environment (CUDA + C++ Compiler Tools)
FROM nvidia/cuda:12.1.1-devel-ubuntu22.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    TORCH_CUDA_ARCH_LIST="8.6" \
    CUDA_HOME=/usr/local/cuda

# Install system python3 (3.10 default for Ubuntu 22.04) & build tooling
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-dev \
    python3-pip \
    cmake \
    ninja-build \
    git \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Upgrade core Python build tooling
RUN python3 -m pip install --no-cache-dir --upgrade pip setuptools wheel

WORKDIR /workspace/CUDAForge

# Install CUDA PyTorch wheel efficiently
RUN python3 -m pip install --no-cache-dir --upgrade pip setuptools wheel pybind11

# Copy source repository
COPY . .

# Build C++/CUDA extensions and install CUDAForge package in editable/dist mode
RUN rm -rf build && \
    cmake -B build -G Ninja \
          -DCMAKE_BUILD_TYPE=Release \
          -DCMAKE_CUDA_ARCHITECTURES=86 \
          -Dpybind11_DIR=$(python3 -m pybind11 --cmakedir) && \
    cmake --build build -j$(nproc) && \
    pip install --no-cache-dir --no-build-isolation --no-deps -e .

# Stage 2: Minimal GPU Runtime
FROM nvidia/cuda:12.1.1-runtime-ubuntu22.04 AS runtime

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PATH="/usr/local/bin:$PATH" \
    PYTHONPATH=/workspace/CUDAForge

WORKDIR /workspace/CUDAForge

# Install runtime python3 and openmp shared libs
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m pip install --no-cache-dir --upgrade pip setuptools wheel && \
    python3 -m pip install --no-cache-dir torch triton numpy
# Copy built site-packages, python binaries, and workspace from builder stage
COPY --from=builder /usr/local/lib/python3.10/dist-packages /usr/local/lib/python3.10/dist-packages
COPY --from=builder /workspace/CUDAForge /workspace/CUDAForge

# Default command: Execute benchmark regression suite
CMD ["python3", "benchmarks/regression_runner.py"]